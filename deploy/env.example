# /etc/site/site.env —— systemd EnvironmentFile（chmod 600，勿入库）
# 启动顺序必须是 druid,prod：prod 覆盖 druid 中的本机地址与监控台开关
SPRING_PROFILES_ACTIVE=druid,prod

# 数据库
SITE_DB_HOST=127.0.0.1
SITE_DB_PORT=3306
SITE_DB_NAME=site
SITE_DB_USERNAME=site
SITE_DB_PASSWORD=CHANGE_ME

# JWT（必填，缺失将启动失败；建议 64 位随机串）
SITE_TOKEN_SECRET=CHANGE_ME_TO_A_64_CHARS_RANDOM_SECRET

# 存储器与日志
SITE_UPLOAD_PATH=/data/site/uploadPath
SITE_LOG_PATH=/data/site/logs
SITE_SERVER_PORT=8080

# Redis
SITE_REDIS_HOST=127.0.0.1
SITE_REDIS_PORT=6379
SITE_REDIS_PASSWORD=

# 站点域名（防盗链 / CORS）
SITE_ALLOWED_DOMAINS=www.example.com,example.com
SITE_CORS_ORIGINS=https://www.example.com,https://example.com
