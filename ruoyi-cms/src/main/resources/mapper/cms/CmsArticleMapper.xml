<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cms.mapper.CmsArticleMapper">

    <resultMap type="CmsArticle" id="CmsArticleResult">
        <id property="articleId" column="article_id" />
        <result property="categoryId" column="category_id" />
        <result property="title" column="title" />
        <result property="cover" column="cover" />
        <result property="summary" column="summary" />
        <result property="content" column="content" />
        <result property="author" column="author" />
        <result property="source" column="source" />
        <result property="viewCount" column="view_count" />
        <result property="isTop" column="is_top" />
        <result property="publishTime" column="publish_time" />
        <result property="status" column="status" />
        <result property="delFlag" column="del_flag" />
        <result property="seoTitle" column="seo_title" />
        <result property="seoKeywords" column="seo_keywords" />
        <result property="seoDescription" column="seo_description" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectArticleVo">
        select article_id, category_id, title, cover, summary, content, author, source,
               view_count, is_top, publish_time, status, del_flag,
               seo_title, seo_keywords, seo_description,
               create_by, create_time, update_by, update_time, remark
        from cms_article
    </sql>

    <sql id="selectArticleCardVo">
        select article_id, category_id, title, cover, summary, author, source,
               view_count, is_top, publish_time, status, del_flag,
               seo_title, seo_keywords, seo_description,
               create_by, create_time, update_by, update_time, remark
        from cms_article
    </sql>

    <select id="selectArticleList" parameterType="CmsArticle" resultMap="CmsArticleResult">
        <include refid="selectArticleCardVo" />
        <where>
            del_flag = '0'
            <if test="title != null and title != ''">AND title like concat('%', #{title}, '%')</if>
            <if test="categoryId != null">AND category_id = #{categoryId}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
            <if test="isTop != null and isTop != ''">AND is_top = #{isTop}</if>
        </where>
        order by is_top desc, publish_time desc, article_id desc
    </select>

    <select id="selectSiteArticleList" parameterType="CmsArticle" resultMap="CmsArticleResult">
        <include refid="selectArticleCardVo" />
        <where>
            del_flag = '0' and status = '0'
            and (publish_time is null or publish_time &lt;= sysdate())
            <if test="categoryId != null">AND category_id = #{categoryId}</if>
            <if test="title != null and title != ''">AND title like concat('%', #{title}, '%')</if>
        </where>
        order by is_top desc, publish_time desc, article_id desc
    </select>

    <select id="selectArticleById" parameterType="Long" resultMap="CmsArticleResult">
        <include refid="selectArticleVo" />
        where article_id = #{articleId} and del_flag = '0'
    </select>

    <select id="selectRelatedArticles" resultMap="CmsArticleResult">
        <include refid="selectArticleCardVo" />
        where del_flag = '0' and status = '0'
          and (publish_time is null or publish_time &lt;= sysdate())
          and article_id != #{excludeId}
          <if test="categoryId != null">and category_id = #{categoryId}</if>
        order by is_top desc, publish_time desc, article_id desc
        limit #{limit}
    </select>

    <insert id="insertArticle" parameterType="CmsArticle" useGeneratedKeys="true" keyProperty="articleId">
        insert into cms_article
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="categoryId != null">category_id,</if>
            <if test="title != null">title,</if>
            <if test="cover != null">cover,</if>
            <if test="summary != null">summary,</if>
            <if test="content != null">content,</if>
            <if test="author != null">author,</if>
            <if test="source != null">source,</if>
            <if test="viewCount != null">view_count,</if>
            <if test="isTop != null">is_top,</if>
            <if test="publishTime != null">publish_time,</if>
            <if test="status != null">status,</if>
            <if test="seoTitle != null">seo_title,</if>
            <if test="seoKeywords != null">seo_keywords,</if>
            <if test="seoDescription != null">seo_description,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="categoryId != null">#{categoryId},</if>
            <if test="title != null">#{title},</if>
            <if test="cover != null">#{cover},</if>
            <if test="summary != null">#{summary},</if>
            <if test="content != null">#{content},</if>
            <if test="author != null">#{author},</if>
            <if test="source != null">#{source},</if>
            <if test="viewCount != null">#{viewCount},</if>
            <if test="isTop != null">#{isTop},</if>
            <if test="publishTime != null">#{publishTime},</if>
            <if test="status != null">#{status},</if>
            <if test="seoTitle != null">#{seoTitle},</if>
            <if test="seoKeywords != null">#{seoKeywords},</if>
            <if test="seoDescription != null">#{seoDescription},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateArticle" parameterType="CmsArticle">
        update cms_article
        <set>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="title != null">title = #{title},</if>
            <if test="cover != null">cover = #{cover},</if>
            <if test="summary != null">summary = #{summary},</if>
            <if test="content != null">content = #{content},</if>
            <if test="author != null">author = #{author},</if>
            <if test="source != null">source = #{source},</if>
            <if test="isTop != null">is_top = #{isTop},</if>
            <if test="publishTime != null">publish_time = #{publishTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="seoTitle != null">seo_title = #{seoTitle},</if>
            <if test="seoKeywords != null">seo_keywords = #{seoKeywords},</if>
            <if test="seoDescription != null">seo_description = #{seoDescription},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where article_id = #{articleId}
    </update>

    <update id="deleteArticleByIds" parameterType="Long">
        update cms_article set del_flag = '2' where article_id in
        <foreach item="articleId" collection="array" open="(" separator="," close=")">
            #{articleId}
        </foreach>
    </update>

    <update id="incrementViewCount" parameterType="Long">
        update cms_article set view_count = view_count + 1 where article_id = #{articleId}
    </update>

</mapper>
