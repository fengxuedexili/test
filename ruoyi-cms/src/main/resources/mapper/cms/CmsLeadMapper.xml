<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cms.mapper.CmsLeadMapper">

    <resultMap type="CmsLead" id="CmsLeadResult">
        <id property="leadId" column="lead_id" />
        <result property="type" column="type" />
        <result property="name" column="name" />
        <result property="phone" column="phone" />
        <result property="province" column="province" />
        <result property="city" column="city" />
        <result property="district" column="district" />
        <result property="productId" column="product_id" />
        <result property="content" column="content" />
        <result property="source" column="source" />
        <result property="utm" column="utm" />
        <result property="ip" column="ip" />
        <result property="status" column="status" />
        <result property="handler" column="handler" />
        <result property="handleTime" column="handle_time" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectLeadVo">
        select lead_id, type, name, phone, province, city, district, product_id, content,
               source, utm, ip, status, handler, handle_time,
               create_by, create_time, update_by, update_time, remark
        from cms_lead
    </sql>

    <select id="selectLeadList" parameterType="CmsLead" resultMap="CmsLeadResult">
        <include refid="selectLeadVo" />
        <where>
            <if test="type != null and type != ''">AND type = #{type}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
            <if test="phone != null and phone != ''">AND phone like concat('%', #{phone}, '%')</if>
            <if test="name != null and name != ''">AND name like concat('%', #{name}, '%')</if>
            <if test="source != null and source != ''">AND source like concat('%', #{source}, '%')</if>
            <if test="params.beginTime != null and params.beginTime != ''">
                AND create_time &gt;= #{params.beginTime}
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                AND create_time &lt;= concat(#{params.endTime}, ' 23:59:59')
            </if>
        </where>
        order by lead_id desc
    </select>

    <select id="selectLeadById" parameterType="Long" resultMap="CmsLeadResult">
        <include refid="selectLeadVo" />
        where lead_id = #{leadId}
    </select>

    <insert id="insertLead" parameterType="CmsLead" useGeneratedKeys="true" keyProperty="leadId">
        insert into cms_lead
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="type != null">type,</if>
            <if test="name != null">name,</if>
            <if test="phone != null">phone,</if>
            <if test="province != null">province,</if>
            <if test="city != null">city,</if>
            <if test="district != null">district,</if>
            <if test="productId != null">product_id,</if>
            <if test="content != null">content,</if>
            <if test="source != null">source,</if>
            <if test="utm != null">utm,</if>
            <if test="ip != null">ip,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="type != null">#{type},</if>
            <if test="name != null">#{name},</if>
            <if test="phone != null">#{phone},</if>
            <if test="province != null">#{province},</if>
            <if test="city != null">#{city},</if>
            <if test="district != null">#{district},</if>
            <if test="productId != null">#{productId},</if>
            <if test="content != null">#{content},</if>
            <if test="source != null">#{source},</if>
            <if test="utm != null">#{utm},</if>
            <if test="ip != null">#{ip},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateLead" parameterType="CmsLead">
        update cms_lead
        <set>
            <if test="status != null">status = #{status},</if>
            <if test="handler != null">handler = #{handler},</if>
            <if test="handleTime != null">handle_time = #{handleTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where lead_id = #{leadId}
    </update>

    <delete id="deleteLeadByIds" parameterType="Long">
        delete from cms_lead where lead_id in
        <foreach item="leadId" collection="array" open="(" separator="," close=")">
            #{leadId}
        </foreach>
    </delete>

</mapper>
